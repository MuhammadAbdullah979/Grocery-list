grocery_list = []
print("Welcome to the grocery list maker!")
running = True
second_running = True
jik = True
third_running = True

# add items
while running:
    choice = input("Do you want to add something to the list(Y/N): ")
    choice = choice.strip()
    choice = choice.upper()
    if choice == "Y":
        yes_command = input("Enter the name of the item you want to add you want to add: ")
        yes_command = yes_command.strip()
        yes_command = yes_command.upper()
        if yes_command != "":
            grocery_list.append(yes_command)
        else:
            print("Cannot add an empty item name")
    elif choice in ("N", "X"):
        running = False
    else:
        print("Wrong input recieved")

for i in range(len(grocery_list)):
    print(i+1, grocery_list[i])

# remove items
while second_running:
    second_choice = input("Do you want to remove something from the list(Y/N): ")
    second_choice = second_choice.strip()
    second_choice = second_choice.upper()
    if second_choice == "Y":
        second_yes_command = input("Enter the name of the item you want to remove: ")
        second_yes_command = second_yes_command.strip()
        second_yes_command = second_yes_command.upper()
        if second_yes_command in grocery_list:
            jik = True
        else:
            jik = False
            print("Item was not found, double check spellings")
        if jik:
            grocery_list.remove(second_yes_command)
    elif second_choice in ("N", "X"):
        second_running = False
    else:
        print("Wrong input recieved")

for i in range(len(grocery_list)):
    print(i+1, grocery_list[i])


# edit an item
while third_running:
    question = input("Would you like to edit a pre-existing item from the list(Y/N): ")
    question = question.strip()
    question = question.upper()
    if question == "Y":
        question3 = input("Enter the number of item you would like to edit: ")
        question3 = question3.strip()
        if question3.isdigit():
            question3 = int(question3)
            question3 = question3 - 1
            item_base = len(grocery_list)
            if 0 <= question3 < item_base:
                question2 = input("Enter the new data for item number you want to change: ")
                question2 = question2.strip()
                question2 = question2.upper()
                grocery_list[question3] = question2
                print("Item updated successfully!")
            else:
                print("Wrong input recieved, item number not found")
        else:
            print("Invalid input recieved, please enter a valid number")
    elif question in ("X", "N"):
        third_running = False
    else:
        print("Wrong input recieved")

for i in range(len(grocery_list)):
    print(i+1, grocery_list[i])


